<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Proshwas - AI Chest X-Ray Screening</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header class="header">
            <h1>🩺 Proshwas</h1>
            <p>AI-Powered Chest Radiograph Analysis & Diagnostic Assistant</p>
        </header>

        <!-- Error Banner Safety Check -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
        <% } %>

        <!-- Success Banner Safety Check -->
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success">
                <%= success %>
            </div>
        <% } %>

        <div class="main-grid">
            <!-- Input Form Section -->
            <div class="form-card">
                <h2>Patient & X-ray Input</h2>
                <form action="/analyze" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="patient_name">Patient Name (optional)</label>
                        <input type="text" id="patient_name" name="patient_name" 
                               value="<%= (typeof formData !== 'undefined' && formData && formData.patient_name) ? formData.patient_name : '' %>" 
                               placeholder="e.g. Anita Roy">
                    </div>

                    <div class="form-group">
                        <label for="age">Age</label>
                        <input type="number" id="age" name="age" 
                               value="<%= (typeof formData !== 'undefined' && formData && formData.age) ? formData.age : '' %>" 
                               placeholder="e.g. 54">
                    </div>

                    <div class="form-group">
                        <label for="patient_id">Patient ID</label>
                        <input type="text" id="patient_id" name="patient_id" 
                               value="<%= (typeof formData !== 'undefined' && formData && formData.patient_id) ? formData.patient_id : '' %>" 
                               placeholder="e.g. 20418">
                    </div>

                    <div class="form-group">
                        <label for="file">Chest X-ray Image</label>
                        <input type="file" id="file" name="file" accept="image/jpeg, image/png" required>
                    </div>

                    <button type="submit" class="btn-submit">Analyze X-ray</button>
                </form>
            </div>

            <!-- Assessment Result Section -->
            <div class="result-card">
                <h2>Assessment Result</h2>
                
                <% if (typeof result !== 'undefined' && result) { %>
                    <div class="result-box">
                        <% if (result.prediction === 'PNEUMONIA') { %>
                            <div class="badge badge-pneumonia">PNEUMONIA DETECTED</div>
                        <% } else { %>
                            <div class="badge badge-normal">NORMAL RADIOGRAPH</div>
                        <% } %>
                        
                        <p><strong>Confidence:</strong> <%= result.confidence_percent %>%</p>
                        
                        <% if (result.overlay_base64) { %>
                            <h3>Grad-CAM Heatmap Analysis</h3>
                            <div class="heatmap-container">
                                <img src="data:image/png;base64,<%= result.overlay_base64 %>" alt="Grad-CAM Heatmap Overlay" style="max-width: 100%; border-radius: 8px;">
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="placeholder-text">
                        <p><em>Awaiting analysis</em></p>
                        <p>Upload an X-ray on the left and click analyze to view diagnostics and heatmap explanations.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>