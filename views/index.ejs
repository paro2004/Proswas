<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Proshwas - AI Chest X-Ray Screening</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="container">
        <header class="header">
            <h1>🩺 Proshwas</h1>
            <p>AI-Powered Chest Radiograph Analysis & Diagnostic Assistant</p>
        </header>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger" style="color: red; background: #ffe6e6; padding: 10px; margin-bottom: 15px; border-radius: 5px;">
                <%= error %>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success" style="color: green; background: #e6ffe6; padding: 10px; margin-bottom: 15px; border-radius: 5px;">
                <%= success %>
            </div>
        <% } %>

        <div class="main-grid" style="display: flex; gap: 20px; flex-wrap: wrap;">
            <!-- Input Form Section -->
            <div class="form-card" style="flex: 1; min-width: 300px; background: #f9f9f9; padding: 20px; border-radius: 8px;">
                <h2>Patient & X-ray Input</h2>
                <form action="/analyze" method="POST" enctype="multipart/form-data">
                    <div class="form-group" style="margin-bottom: 15px;">
                        <label for="patient_name">Patient Name (optional)</label><br>
                        <input type="text" id="patient_name" name="patient_name" 
                               value="<%= (typeof formData !== 'undefined' && formData && formData.patient_name) ? formData.patient_name : '' %>" 
                               placeholder="e.g. Anita Roy" style="width: 100%; padding: 8px; margin-top: 5px;">
                    </div>

                    <div class="form-group" style="margin-bottom: 15px;">
                        <label for="age">Age</label><br>
                        <input type="number" id="age" name="age" 
                               value="<%= (typeof formData !== 'undefined' && formData && formData.age) ? formData.age : '' %>" 
                               placeholder="e.g. 54" style="width: 100%; padding: 8px; margin-top: 5px;">
                    </div>

                    <div class="form-group" style="margin-bottom: 15px;">
                        <label for="patient_id">Patient ID</label><br>
                        <input type="text" id="patient_id" name="patient_id" 
                               value="<%= (typeof formData !== 'undefined' && formData && formData.patient_id) ? formData.patient_id : '' %>" 
                               placeholder="e.g. 20418" style="width: 100%; padding: 8px; margin-top: 5px;">
                    </div>

                    <div class="form-group" style="margin-bottom: 15px;">
                        <label for="file">Chest X-ray Image</label><br>
                        <input type="file" id="file" name="file" accept="image/jpeg, image/png" required style="margin-top: 5px;">
                    </div>

                    <button type="submit" class="btn-submit" style="background: #007bff; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer;">Analyze X-ray</button>
                </form>
            </div>

            <!-- Assessment Result Section -->
            <div class="result-card" style="flex: 1; min-width: 300px; background: #f9f9f9; padding: 20px; border-radius: 8px;">
                <h2>Assessment Result</h2>
                
                <% if (typeof result !== 'undefined' && result && result.prediction) { %>
                    <div class="result-box">
                        <% if (result.prediction === 'PNEUMONIA') { %>
                            <div class="badge badge-pneumonia" style="background: red; color: white; padding: 5px 10px; display: inline-block; font-weight: bold; border-radius: 4px; margin-bottom: 10px;">PNEUMONIA DETECTED</div>
                        <% } else { %>
                            <div class="badge badge-normal" style="background: green; color: white; padding: 5px 10px; display: inline-block; font-weight: bold; border-radius: 4px; margin-bottom: 10px;">NORMAL RADIOGRAPH</div>
                        <% } %>
                        
                        <p><strong>Confidence:</strong> <%= result.confidence_percent %>%</p>
                        
                        <% if (result.overlay_base64) { %>
                            <h3>Grad-CAM Heatmap Analysis</h3>
                            <div class="heatmap-container" style="margin-top: 10px;">
                                <img src="data:image/png;base64,<%= result.overlay_base64 %>" alt="Grad-CAM Heatmap Overlay" style="max-width: 100%; border-radius: 8px;">
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="placeholder-text" style="color: #666; margin-top: 20px;">
                        <p><em>Awaiting analysis...</em></p>
                        <p>Upload a chest X-ray on the left and click analyze to view diagnostics and heatmap explanations.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>